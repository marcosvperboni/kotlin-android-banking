<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows cleartext traffic to the local emulator host alias only, so the debug build
         can talk to the demo backend running on the developer machine without HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
